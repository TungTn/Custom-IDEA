{
  "name": "custom-idea",
  "private": true,
  "version": "0.1.2",
  "license": "Apache-2.0",
  "author": "TungTN",
  "packageManager": "pnpm@10.13.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:portable": "tauri build --no-bundle && powershell -Command \"New-Item -ItemType Directory -Path dist-portable -Force; try { Copy-Item target/release/app.exe dist-portable/Custom-IDEA-Portable.exe -Force } catch { Write-Warning 'File Custom-IDEA-Portable.exe dang mo, ban moi nam tai target/release/app.exe' }\"",
    "publish:update": "node scripts/publish-update.cjs",
    "release": "node scripts/publish-update.cjs",
    "update:mock-server": "node scripts/mock-update-server.mjs",
    "gen:bindings": "cargo test -p app --test export_bindings"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-less": "^6.0.2",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-vim": "^6.4.0",
    "@tanstack/react-virtual": "^3.14.25",
    "@tauri-apps/api": "^2.12.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.8.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
